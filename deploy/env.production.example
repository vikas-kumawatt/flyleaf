# Flyleaf production environment -- the TEMPLATE. Never put a real secret in
# this file: it is committed.
#
# On the server, deploy/configure-env.sh turns it into /etc/flyleaf/flyleaf.env
# (root, mode 600): it generates the random secrets, asks for the rest (or
# reads them from a local answers file with mode 600) and never echoes them.
# Edit that file by hand afterwards if you need to, then run
# `sudo /opt/flyleaf/deploy/provision.sh` to apply the change.
#
# SYNTAX. This is a bash file, read with `source`. Two rules:
#   - secrets and literals in 'single quotes' (nothing inside is expanded);
#   - values built from other values in "double quotes", e.g. "https://${FLYLEAF_HOST}".
# provision.sh renders it to /etc/flyleaf/app.env with every value literal,
# which is what systemd, docker compose and the scripts read. No value may
# contain a single quote or a newline (configure-env.sh refuses them).
#
# Placeholders in angle brackets with no @ inside (<...>) are what
# configure-env.sh fills in; the app refuses to start while any is left.

# ---------------------------------------------------------------------------
# The host name. THE one place it is set: Caddy's certificate, the emailed
# links (APP_BASE_URL), CORS, and the storage URLs that phones upload to all
# derive from it. Today the VM's free Azure name; moving to a real domain is
# this line plus a DNS record (docs/deploy.md, "Moving to a real domain").
FLYLEAF_HOST='<label>.<region>.cloudapp.azure.com'

# Who gets backup-failure mail, restore-drill reports and Let's Encrypt
# expiry notices.
OWNER_EMAIL='<your-email>'

# Where the code comes from (release.sh). SSH with a read-only deploy key if
# the repository is private; provision.sh creates the key and prints it.
REPO_URL='git@github.com:vikas-kumawatt/flyleaf.git'
REPO_REF='main'

# ---------------------------------------------------------------------------
# The app (apps/api). Production refuses to start with a development adapter
# or a missing credential, and the message names the variable (README §3d).
NODE_ENV='production'
LOG_LEVEL='info'
# Caddy is the only thing that talks to the API, over loopback.
HOST='127.0.0.1'
PORT='3000'

# At least 32 random bytes. configure-env.sh runs: openssl rand -base64 48
# Changing it signs everyone out (every access and refresh token is refused).
JWT_SECRET='<generated>'

# Caddy is on this machine: trust exactly loopback, so X-Forwarded-For from
# Caddy is believed and from anyone else is not. Never `true` here.
TRUST_PROXY='127.0.0.1'

# Base of the links in verification and password-reset emails. The API serves
# those pages itself at the root (README, "Email links and App Links").
APP_BASE_URL="https://${FLYLEAF_HOST}"

# Postgres (deploy/compose.production.yml), loopback only. Three roles
# (deploy/db/roles.sql): the container's superuser, for backups and restores
# only; flyleaf_owner, which owns the schema and runs migrations; and
# flyleaf_app, which the API and worker use: rows only, no DDL.
POSTGRES_PASSWORD='<generated>'
OWNER_DB_PASSWORD='<generated>'
APP_DB_PASSWORD='<generated>'
DATABASE_URL="postgres://flyleaf_app:${APP_DB_PASSWORD}@127.0.0.1:5432/flyleaf"
MIGRATION_DATABASE_URL="postgres://flyleaf_owner:${OWNER_DB_PASSWORD}@127.0.0.1:5432/flyleaf"
# The app role may not create schemas, so pg-boss must not try: roles.sql
# pre-creates `pgboss`, owned by flyleaf_app, and pg-boss builds its tables in it.
PGBOSS_CREATE_SCHEMA='false'

# ---------------------------------------------------------------------------
# Object storage: the local MinIO, reached by phones THROUGH CADDY at
# https://<host>/<bucket>/... (path style). Presigned URLs are signed for
# S3_ENDPOINT, so it must be the public https address, not 127.0.0.1:9000;
# provision.sh maps the host name to 127.0.0.1 in /etc/hosts so the API's
# own calls go to Caddy on this machine instead of out and back in.
STORAGE_DRIVER='s3'
S3_ENDPOINT="https://${FLYLEAF_HOST}"
S3_FORCE_PATH_STYLE='true'
S3_REGION='us-east-1'
# The bucket name is also the URL path Caddy sends to MinIO, so it must not
# collide with an API route (/v1, /admin, /healthz, /u/...).
S3_BUCKET='flyleaf-files'
# A key that can touch only S3_BUCKET (provision.sh creates it), not the
# MinIO root account below.
S3_ACCESS_KEY_ID='<generated>'
S3_SECRET_ACCESS_KEY='<generated>'

# MinIO's own administrator. Used only by provision.sh; the app never sees it.
MINIO_ROOT_USER='flyleaf-admin'
MINIO_ROOT_PASSWORD='<generated>'

# ---------------------------------------------------------------------------
# Email: Gmail SMTP with an app password (Google Account -> Security ->
# 2-Step Verification -> App passwords; 2-Step Verification must be on).
# The user part is URL-encoded (@ is %40); the app password has no spaces.
# Gmail rewrites From to the account's own address unless the address is a
# verified "Send mail as" alias, so EMAIL_FROM uses the account address.
EMAIL_DRIVER='smtp'
SMTP_URL='smtps://<you%40gmail.com>:<16-letter-app-password>@smtp.gmail.com:465'
EMAIL_FROM='Flyleaf <filled-in-from-the-gmail-address>'

# Push: Expo's push service. The access token is needed only when "Enhanced
# Security for Push Notifications" is on for the Expo project (expo.dev ->
# project -> Credentials / Access tokens). Leave it empty otherwise.
PUSH_DRIVER='expo'
EXPO_ACCESS_TOKEN=''

# Error reporting: noop until a Sentry project exists (then sentry + SENTRY_DSN).
ERROR_DRIVER='noop'

# App Links for the emailed links and public pages (optional; README "Email
# links and App Links"). The SHA-256 is the EAS signing key's fingerprint:
# docs/mobile-release.md step 7. Uncomment both, then provision.sh.
# ANDROID_APP_PACKAGE='app.flyleaf.skeleton'
# ANDROID_CERT_SHA256='AA:BB:...'

# ---------------------------------------------------------------------------
# Images, pinned on purpose: an upgrade is a change to this file, not a
# surprise at the next restart.
POSTGRES_IMAGE='postgres:18-alpine'
# MinIO stopped publishing images to Docker Hub (minio/minio no longer
# exists there). pgsty/minio is Pigsty's build of the same open-source MinIO,
# still released. Any S3-compatible server works: the app only needs S3.
MINIO_IMAGE='pgsty/minio:RELEASE.2026-08-04T00-00-00Z'
# Node major for the API and worker (apps/api engines: >=22; CI runs 22).
NODE_MAJOR='22'

# ---------------------------------------------------------------------------
# Backups (deploy/backup/). rclone remote and folder: configured with
# `rclone config` at deploy time (docs/deploy.md step 9).
BACKUP_REMOTE='gdrive:flyleaf-backups'
# The age public key the backups are encrypted to. configure-env.sh creates
# the key pair; the private half is /etc/flyleaf/backup.agekey and MUST also
# be kept off this machine (password manager), or the backups are useless
# the day this machine is gone.
BACKUP_AGE_RECIPIENT='<generated>'
# Optional dead-man's switch: a URL pinged after every successful backup
# (e.g. a free healthchecks.io check that mails you when pings stop).
BACKUP_PING_URL=''
