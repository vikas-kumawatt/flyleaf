# Every 6 hours, UTC (05:30, 11:30, 17:30, 23:30 IST). Persistent: a run
# missed while the machine was off happens at the next boot.
[Unit]
Description=Flyleaf backup every 6 hours

[Timer]
OnCalendar=*-*-* 00,06,12,18:00:00 UTC
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
