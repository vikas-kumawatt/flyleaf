# Copy to .env for anything non-default. The defaults match docker-compose.yml.
DATABASE_URL=postgres://flyleaf:flyleaf@localhost:5432/flyleaf?sslmode=disable
FLYLEAF_ADDR=:8080
FLYLEAF_ENV=dev

# --- Production (audit Part 04) ---
# Required when NODE_ENV=production: the API refuses to start without a private
# value of at least 32 bytes. Generate: openssl rand -base64 48
# JWT_SECRET=
# Off unless set. Behind Caddy, set Caddy's address or CIDR (comma-separated),
# or every request appears to come from Caddy. `true` trusts every hop.
# TRUST_PROXY=127.0.0.1
# Base of the links in verification and reset emails.
# APP_BASE_URL=https://flyleaf.app
