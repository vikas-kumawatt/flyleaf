# Copy to .env for anything non-default. The defaults match docker-compose.yml.
DATABASE_URL=postgres://flyleaf:flyleaf@localhost:5432/flyleaf?sslmode=disable
FLYLEAF_ADDR=:8080
FLYLEAF_ENV=dev

# --- Production (audit Part 04) ---
# Required when NODE_ENV=production: the API refuses to start without a private
# value of at least 32 bytes. Generate: openssl rand -base64 48
# JWT_SECRET=
# Off unless set. Behind Caddy, set Caddy's address or CIDR (comma-separated),
# or every request appears to come from Caddy. `true` trusts every hop.
# TRUST_PROXY=127.0.0.1
# Base of the links in verification and reset emails.
# APP_BASE_URL=https://flyleaf.app
# App Links / Universal Links for those links (audit 07b). Unset: the
# /.well-known files 404. A malformed value stops the API at start-up.
# ANDROID_APP_PACKAGE=app.flyleaf.skeleton
# ANDROID_CERT_SHA256=AA:BB:...   # comma-separated, one per signing certificate
# IOS_TEAM_ID=ABCDE12345
# IOS_BUNDLE_ID=app.flyleaf.skeleton

# --- Providers (PV-0x; README section 3d) ---
# Production refuses to start with a dev adapter (disk, memory, console) or a
# missing credential. Unset in development: disk, console, memory, noop.
# STORAGE_DRIVER=s3
# S3_BUCKET=flyleaf
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true        # MinIO
# Development disk storage: where a phone reaches this API (LAN address).
# STORAGE_PUBLIC_URL=http://192.168.1.20:3000
# EMAIL_DRIVER=smtp
# SMTP_URL=smtps://user:pass@smtp.postmarkapp.com:465
# EMAIL_FROM=Flyleaf <no-reply@flyleaf.app>
# PUSH_DRIVER=expo
# EXPO_ACCESS_TOKEN=
# ERROR_DRIVER=sentry
# SENTRY_DSN=
# SENTRY_RELEASE=
