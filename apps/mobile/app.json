{
  "expo": {
    "name": "Flyleaf",
    "slug": "flyleaf",
    "scheme": "flyleaf",
    "version": "0.1.0-beta.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.flyleaf",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "flyleaf.app", "path": "/verify-email" },
            { "scheme": "https", "host": "flyleaf.app", "path": "/reset-password" },
            { "scheme": "https", "host": "flyleaf.app", "pathPrefix": "/@" },
            { "scheme": "https", "host": "flyleaf.app", "pathPrefix": "/book/" },
            { "scheme": "https", "host": "flyleaf.app", "pathPrefix": "/u/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "flyleaf-vk.koreacentral.cloudapp.azure.com", "path": "/verify-email" },
            { "scheme": "https", "host": "flyleaf-vk.koreacentral.cloudapp.azure.com", "path": "/reset-password" },
            { "scheme": "https", "host": "flyleaf-vk.koreacentral.cloudapp.azure.com", "pathPrefix": "/@" },
            { "scheme": "https", "host": "flyleaf-vk.koreacentral.cloudapp.azure.com", "pathPrefix": "/book/" },
            { "scheme": "https", "host": "flyleaf-vk.koreacentral.cloudapp.azure.com", "pathPrefix": "/u/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "app.flyleaf",
      "supportsTablet": false,
      "associatedDomains": ["applinks:flyleaf.app", "applinks:flyleaf-vk.koreacentral.cloudapp.azure.com"]
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Flyleaf uses the camera to scan book barcodes."
        }
      ],
      "expo-image",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Flyleaf uses your photos to set your profile picture.",
          "cameraPermission": "Flyleaf uses the camera to scan book barcodes and to take a profile picture."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "_apiUrlNote": "apiUrl is set by app.config.ts from FLYLEAF_API_URL (eas.json build profile env). Unset in development: src/lib/apiBase.ts derives the host from Expo's dev server.",
      "router": {},
      "eas": {
        "projectId": "1458ebc2-9f8c-461d-8c77-777a72b0b7e9"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1458ebc2-9f8c-461d-8c77-777a72b0b7e9"
    }
  }
}
