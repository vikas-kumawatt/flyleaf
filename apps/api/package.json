{
  "name": "@flyleaf/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx watch src/worker.ts",
    "ping": "tsx src/worker.ts --ping",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "ingest": "tsx src/ingest.ts",
    "dedupe": "tsx src/dedupe.ts",
    "devdb:build": "tsx src/devdb.ts",
    "ingest:fetch": "tsx src/fetch-dumps.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spec:generate": "tsx src/contract/generate.ts",
    "spec:check": "tsx src/contract/generate.ts --check",
    "bench:seed": "tsx src/bench/seed.ts",
    "bench": "tsx src/bench/run.ts",
    "bench:routes": "tsx src/bench/routes.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@node-rs/argon2": "2.2.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "jose": "6.2.10",
    "pg-boss": "12.30.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.9",
    "yaml": "^2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.4.1",
    "autocannon": "8.0.0",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
