{
  "name": "@flyleaf/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx src/seed.ts",
    "ingest": "tsx src/ingest.ts",
    "ingest:fetch": "tsx src/fetch-dumps.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@node-rs/argon2": "2.2.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "jose": "6.2.10",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.4.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
